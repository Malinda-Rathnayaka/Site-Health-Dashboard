# ─────────────────────────────────────────────────────────────
# Site Health Dashboard — Server Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in REAL values.
#   cp .env.example .env
# NEVER commit the real .env — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas or local)
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>
# Example local: mongodb://localhost:27017/site-health-dashboard
MONGO_URI=

# JWT
# Generate a strong random secret, e.g.:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# CORS — the origin your React client runs on
CLIENT_ORIGIN=http://localhost:5173

# Rate limiting on /api/auth/login  (brute-force protection)
# Window in milliseconds (default 15 min = 900000)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Max attempts per window per IP
LOGIN_RATE_LIMIT_MAX=10

# Seed Admin Credentials (used only by `npm run seed`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Admin
